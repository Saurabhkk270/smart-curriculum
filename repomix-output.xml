interface Class {
  id: string;
  name: string;
  code: string;
}

interface Announcement {
  id: string;
  title: string;
  content: string;
  deadline: string | null;
  created_at: string;
  classes: {
    name: string;
    code: string;
  };
}

const TeacherAnnouncements = () => {
